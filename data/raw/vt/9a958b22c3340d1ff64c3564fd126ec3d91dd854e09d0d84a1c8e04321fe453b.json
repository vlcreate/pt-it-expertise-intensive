35ca94c3396", "sigma_analysis_summary": {"Sigma Integrated Rule Set (GitHub)": {"critical": 0, "high": 1, "medium": 2, "low": 0}}, "total_votes": {"harmless": 0, "malicious": 1}, "type_tags": ["executable", "windows", "win32", "pe", "peexe"], "size": 2514944, "last_analysis_date": 1793195604, "crowdsourced_ids_stats": {"high": 0, "medium": 0, "low": 9, "info": 0}, "reputation": -11, "sigma_analysis_results": [{"rule_level": "high", "rule_id": "293439c3a9a4af09073b054953f425c95028a6ac98eddc611a461090bd1f3373", "rule_source": "Sigma Integrated Rule Set (GitHub)", "rule_title": "Potential Remote SquiblyTwo Technique Execution", "rule_description": "Detects potential execution of the SquiblyTwo technique that leverages Windows Management Instrumentation (WMI)\nto execute malicious code remotely. This technique bypasses application whitelisting by using wmic.exe to process\nmalicious XSL (eXtensible Stylesheet Language) scripts that can contain embedded JScript or VBScript.\nThe attack typically works by fetching XSL content from a remote source (using HTTP/HTTPS) and executing it\nwith full trust privileges directly in memory, avoiding disk-based detection mechanisms. This is a common\nLOLBin (Living Off The Land Binary) technique used for defense evasion and code execution.\n", "rule_author": "Markus Neis, Florian Roth, Swachchhanda Shrawan Poudel (Nextron Systems)", "match_context": [{"values": {"Hashes": "SHA1=E06B133701B7637AB1EB58E6328F8CBF8EC727D0,MD5=E4CF847182D343390B2CFEF403FDC4B4,SHA256=AD00BAC8EF95A836700EB8FCAC345AD8DA6601A45FA83416041896233269700F,IMPHASH=43C6BE584D77B658A53A9A5C606724DD", "CurrentDirectory": "C:\\Users\\Bruno\\Desktop\\", "OriginalFileName": "wmic.exe", "Product": "Microsoft\\xae Windows\\xae Operating System", "Description": "WMI Commandline Utility", "FileVersion": "10.0.22621.2215 (WinBuild.160101.0800)", "ParentCommandLine": "C:\\Windows\\system32\\cmd.exe /c wmic /namespace:\\\\root\\SecurityCenter2 path AntiVirusProduct get displayName, productState /format:list 2>nul", "CommandLine": "wmic  /namespace:\\\\root\\SecurityCenter2 path AntiVirusProduct get displayName, productState /format:list ", "EventID": "1", "ParentImage": "C:\\Windows\\System32\\cmd.exe", "IntegrityLevel": "High", "Image": "C:\\Windows\\System32\\wbem\\WMIC.exe", "Company": "Microsoft Corporation"}}]}, {"rule_level": "medium", "rule_id": "04969458bf2b005665d6b29fa937ccdfac26516eac5746c80ed78581033094c3", "rule_source": "Sigma Integrated Rule Set (GitHub)", "rule_title": "Potential Product Reconnaissance Via Wmic.EXE", "rule_description": "Detects the execution of WMIC in order to get a list of firewall and antivirus products", "rule_author": "Nasreddine Bencherchali", "match_context": [{"values": {"Hashes": "SHA1=E06B133701B7637AB1EB58E6328F8CBF8EC727D0,MD5=E4CF847182D343390B2CFEF403FDC4B4,SHA256=AD00BAC8EF95A836700EB8FCAC345AD8DA6601A45FA83416041896233269700F,IMPHASH=43C6BE584D77B658A53A9A5C606724DD", "CurrentDirectory": "C:\\Users\\Bruno\\Desktop\\", "OriginalFileName": "wmic.exe", "Product": "Microsoft\\xae Windows\\xae Operating System", "Description": "WMI Commandline Utility", "FileVersion": "10.0.22621.2215 (WinBuild.160101.0800)", "ParentCommandLine": "C:\\Windows\\system32\\cmd.exe /c wmic /namespace:\\\\root\\SecurityCenter2 path AntiVirusProduct get displayName, productState /format:list 2>nul", "CommandLine": "wmic  /namespace:\\\\root\\SecurityCenter2 path AntiVirusProduct get displayName, productState /format:list ", "EventID": "1", "ParentImage": "C:\\Windows\\System32\\cmd.exe", "IntegrityLevel": "High", "Image": "C:\\Windows\\System32\\wbem\\WMIC.exe", "Company": "Microsoft Corporation"}}]}, {"rule_level": "medium", "rule_id": "fc6236ee6917b72dac2442d623fbec008944e69e1788346494f1f98b38acb5c9", "rule_source": "Sigma Integrated Rule Set (GitHub)", "rule_title": "Potential Product Class Reconnaissance Via Wmic.EXE", "rule_description": "Detects the execution of WMIC in order to get a list of firewall, antivirus