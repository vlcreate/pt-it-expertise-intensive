# Скопируйте в secrets.env и впишите свои ключи. secrets.env в git не попадает.

# VirusTotal: профиль -> API key
VT_API_KEY=

# abuse.ch (auth.abuse.ch). Тот же ключ открывает MalwareBazaar.
MB_AUTH_KEY=

# Необязательно. Нужен, если virustotal.com недоступен напрямую.
# HTTPS_PROXY=http://127.0.0.1:10809
